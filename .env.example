# Node 环境
NODE_ENV=development

# 数据库配置
# 本地开发使用本地 SQLite 数据库
TURSO_DATABASE_URL=http://127.0.0.1:8080
TURSO_AUTH_TOKEN=

# 生产环境使用远程 Turso 数据库
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Better Auth 配置
BETTER_AUTH_SECRET=your-32-byte-random-secret-here
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth 配置
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# S3 兼容存储配置
# 本地开发使用 MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=images
S3_REGION=us-east-1
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key

# 生产环境使用 Tigris（推荐 - 免费 5GB + 零流量费）
# S3_ENDPOINT=https://fly.storage.tigris.dev
# S3_BUCKET=your-tigris-bucket-name
# S3_REGION=auto
# S3_ACCESS_KEY=tid_your_tigris_access_key
# S3_SECRET_KEY=tsec_your_tigris_secret_key

# 或使用 Cloudflare R2
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# S3_BUCKET=your-r2-bucket-name
# S3_REGION=auto
# S3_ACCESS_KEY=your-r2-access-key
# S3_SECRET_KEY=your-r2-secret-key

# 或使用 AWS S3
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=your-production-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-aws-access-key
# S3_SECRET_KEY=your-aws-secret-key

# MinIO 本地开发配置（仅用于 docker-compose）
MINIO_ROOT_USER=mynuxt
MINIO_ROOT_PASSWORD=nuxt123456
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
